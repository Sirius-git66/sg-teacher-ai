# Telegram notification credentials for Sentinel
# Get these from:
#   1. @BotFather on Telegram → create a bot → copy the token
#   2. @userinfobot on Telegram → get your chat ID
#
# Add these as GitHub Secrets (not in this file) for GitHub Actions:
#   TELEGRAM_BOT_TOKEN
#   TELEGRAM_CHAT_ID

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
